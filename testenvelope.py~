import sys
import kernel0d as zd

import looper

class Env:
    def __init__ (self):
        self.x = 1
        self.w = 100
        self.eh = None
        self.reverse = self.rev
    def rev (eh):
        zd.send (eh, "", " ** reverse **", mev)
        
def handler (eh,mev):
    global x
    uut = eh.instance_data
    try:
        if mev.port == "x":
            x = int (mev.datum.v)
            uut.step ()
            zd.send (eh, "", f"state: {uut.state}", mev)
    except Exception as ex:
        zd.send (eh, "✗", f"*** error in looper test.py ({ex}) ***", mev)

def reset_handler (eh):
    global x
    x = 1
    
def instantiate (reg,owner,name, arg, template_data):
    name_with_id = zd.gensymbol ( "Looper Tester")
    env = Env ()
    uut = looper.SM_looper(env=env) # uut == unit under test
    eh = zd.make_leaf ( name_with_id, owner, uut, arg, handler, reset_handler)
    env.eh = eh
    return eh

# define template
def install (reg):
    zd.register_component (reg, zd.mkTemplate ("Looper Tester", None, instantiate))


