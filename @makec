#!/bin/bash

######### commands specific to this project #############

target=looper
vsh=smdpl

# 1. rebuild the transmogrifier ("compiler") every time...
${PBP}/das2json ${vsh}.drawio
python smdpl.py ${target}.drawio main ${vsh}.drawio.json | ${PBP}/splitoutputs

# 2. if no errors (i.e. "out.py" was created instead of "out.✗") rename it to "looper.py"
if [ -f "out.py" ]; then
    cat out.py | python replace.py "✣" "${target}" >"${target}.py"

    # 3. run the test jig, which includes looper.py. The test jig, itself, is drawn as a diagram "testjig.drawio" and needs "testermain.py" to kick it off
    # and installs the parts (formatted for use in the diagram) needed by the test jig ("stimulus.py" and "testenvelope.py" (which imports "looper.py"))
    echo '*** automated test ***'
    #export PBPSTEPPING="1"
    ${PBP}/das2json testjig.drawio
    python testermain.py "" test testjig.drawio.json
else
    exit 1
fi

