machine "looper" {
    state "idle" {
        {}
        {
            %next "wait for max recrossing" %when (e.x > e.max) {e.reverse ()}
            %next "wait for min recrossing" %when (e.x < e.min) {e.reverse ()}
            }
        {}
        }
    state "wait for max recrossing" {
        {}
        {
            %next "idle" %when (e.x < e.max)
            }
        {}
        }
    state "wait for min recrossing" {
        {}
        {
            %next "idle" %when (e.x > e.min)
            }
        {}
        }
    
    }